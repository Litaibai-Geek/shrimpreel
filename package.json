{
  "name": "shrimpreel",
  "private": true,
  "license": "MIT",
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "npm run build && wrangler dev --port 8787",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:smoke": "playwright test -c playwright.smoke.config.ts",
    "test:sandbox": "playwright test -c playwright.sandbox.config.ts",
    "seo:check": "node scripts/seo-check.mjs",
    "seo:indexnow": "node scripts/indexnow.mjs",
    "cf:types": "wrangler types --strict-vars=false",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "seed:local": "node scripts/seed-local.mjs",
    "seed:remote": "node scripts/seed-remote.mjs",
    "db:migrate:remote": "node scripts/wrangler-platform.mjs d1 migrations apply DB --remote",
    "doctor": "node scripts/doctor.mjs",
    "deploy": "node scripts/pre-deploy.mjs && npm run doctor && npm run seed:remote -- --verify && npm run typecheck && npm test && npm run build && node scripts/wrangler-platform.mjs deploy",
    "media:placeholder": "node scripts/generate-placeholder-media.mjs",
    "media:download": "node scripts/download-demo-media.mjs",
    "setup": "node scripts/bootstrap-site.mjs",
    "setup:platforms": "node scripts/bootstrap-platforms.mjs",
    "sync:wrangler": "node scripts/sync-wrangler-vars.mjs",
    "dns:update": "node scripts/update-nameservers.mjs"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "1.66.0",
    "@tailwindcss/vite": "4.3.1",
    "@tanstack/react-router": "1.170.45",
    "@tanstack/react-start": "1.169.3",
    "@tanstack/router-plugin": "1.168.47",
    "hono": "4.13.13",
    "lucide-react": "1.21.0",
    "mediabunny": "^1.65.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tailwindcss": "4.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "25.9.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "4.1.12",
    "wrangler": "^4.152.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11.19.0",
      "onFail": "warn"
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261023.1": true
  }
}
